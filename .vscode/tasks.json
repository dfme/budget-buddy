{
  // VS-Code-Pendant zu IntelliJ "Run Configurations".
  //
  // "Dev: Full Stack" startet Datenbank (:5432), Backend (:8080) und Frontend (:4200)
  // und ist als Default-Build-Task hinterlegt → Cmd+Shift+B (macOS) / Ctrl+Shift+B
  // startet alles auf einen Schlag. Alternativ: Cmd+Shift+P → "Tasks: Run Task".
  // Voraussetzung: Docker läuft (ADR-12).
  //
  // Kein Secret im Git: die Backend-Task erzeugt beim Start ein Wegwerf-JWT_SECRET
  // (openssl). Es wechselt bei jedem Neustart — d. h. eine bestehende Login-Session
  // wird ungültig, man muss sich neu einloggen. Wer eine stabile Session über
  // Neustarts hinweg will, setzt JWT_SECRET einmalig im Shell-Profil und ersetzt den
  // command unten durch nur "./mvnw spring-boot:run".
  "version": "2.0.0",
  "tasks": [
    {
      // Seit DB-05 (ADR-12) läuft die Datenbank als Container. Ohne sie startet das
      // Backend nicht — deshalb hängt die Backend-Task davor, statt sich auf einen
      // manuellen `docker compose up -d` im Terminal zu verlassen.
      //
      // `--wait` blockiert bis zum Healthcheck aus docker-compose.yml. Ohne das Flag
      // gilt der Container als gestartet, während Postgres noch initialisiert, und das
      // Backend liefe in einen Verbindungsfehler.
      "label": "Datenbank: docker compose up",
      "type": "shell",
      "command": "docker compose up -d --wait",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "panel": "dedicated",
        "group": "dev",
        // Läuft durch und beendet sich — bei Erfolg kein Grund, das Panel aufzuziehen.
        "reveal": "silent"
      }
    },
    {
      "label": "Backend: spring-boot:run",
      "type": "shell",
      "command": "JWT_SECRET=\"$(openssl rand -base64 48)\" ./mvnw spring-boot:run",
      "options": {
        "cwd": "${workspaceFolder}/backend"
      },
      "dependsOn": ["Datenbank: docker compose up"],
      "isBackground": true,
      "problemMatcher": [],
      "presentation": {
        "panel": "dedicated",
        "group": "dev",
        "reveal": "always"
      }
    },
    {
      "label": "Frontend: ng serve",
      "type": "shell",
      "command": "npx ng serve",
      "options": {
        "cwd": "${workspaceFolder}/frontend"
      },
      "isBackground": true,
      // Background-Matcher: signalisiert VS Code, wann der Dev-Server bereit ist,
      // damit ein Chrome-Debug-Launch (preLaunchTask) nicht ewig "wartet". Der
      // endsPattern trifft die Angular-esbuild-Ausgabe ("… bundle generation
      // complete", "Watch mode enabled" bzw. die Local-URL).
      "problemMatcher": {
        "owner": "angular",
        "pattern": {
          "regexp": "^$"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "(Building|Application bundle generation)",
          "endsPattern": "(bundle generation complete|Watch mode enabled|Local:\\s+http)"
        }
      },
      "presentation": {
        "panel": "dedicated",
        "group": "dev",
        "reveal": "always"
      }
    },
    {
      "label": "Dev: Full Stack",
      "dependsOn": ["Backend: spring-boot:run", "Frontend: ng serve"],
      "dependsOrder": "parallel",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": []
    }
  ]
}
